{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reconciliar-cancelamentos",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|@vite(?:/|$)|@react-refresh(?:/|$)|src(?:/|$)|assets(?:/|$)|node_modules(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
