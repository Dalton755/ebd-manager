{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebd-manager",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/asaas/*"
    ]
  },
  "previews": {},
  "main": "worker/index.ts"
}
